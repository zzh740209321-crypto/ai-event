# LiteLLM gateway (OpenAI-compatible). Copy to .env or .env.litellm and fill in values.
# Do not commit real keys. .env* files are gitignored except this example.

# Required: company LiteLLM proxy base URL, including the /v1 suffix.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1

# Required: key issued by the company LiteLLM gateway (or a virtual key).
LITELLM_API_KEY=sk-litellm-replace-me

# Optional aliases by purpose. These names must exist in the gateway model_list
# (see configs/litellm_config.yaml). Defaults are shown below.
LITELLM_MODEL_ATTRIBUTION=gemini-flash-lite
LITELLM_MODEL_LABEL=gemini-flash-lite
LITELLM_MODEL_FACTCHECK=perplexity-sonar

# Optional fallback if a purpose-specific model is unset.
# LITELLM_MODEL=gemini-flash-lite

# Demo only: if LITELLM_API_KEY is empty, OPENROUTER_API_KEY may be used
# when LITELLM_BASE_URL points at an OpenAI-compatible demo endpoint.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
